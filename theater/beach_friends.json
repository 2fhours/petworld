    {
      "id": "bf_hungry",
      "type": "wait",
      "text": "Playing makes you hungry!",
      "zh": "玩累了饿了",
      "guide": "请说英文：I'm hungry / feed me / apple",
      "expect": ["i'm hungry", "i am hungry", "feed me", "apple", "eat apple", "hungry"],
